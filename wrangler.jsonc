{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shaaka",
  "main": "./backend/worker.js",
  "compatibility_date": "2026-11-14",
  "keep_vars": true,
  "containers": [
    {
      "class_name": "ShaakaBackend",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-2"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "ShaakaBackend"
      }
    ]
  },
  "exports": {
    "ShaakaBackend": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
