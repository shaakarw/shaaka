{
  "expo": {
    "name": "shaaka",
    "slug": "shaaka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.shaaka",
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 21
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Shaaka to access your photos to save images.",
          "savePhotosPermission": "Allow Shaaka to save images to your gallery.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video",
      "expo-sqlite",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d3a023d7-8b01-4084-a888-a0e99844aba9"
      }
    },
    "owner": "segoremys-team"
  }
}