
{
  "expo": {
    "name": "Shaaka",
    "slug": "shaka",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.anonymous.shaaka",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.shaaka",
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-asset",
      "./plugins/withExpoMavenRepositories",
      "./plugins/withAndroidEmulatorNetworkSecurity",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Shaaka to access your photos to save images.",
          "savePhotosPermission": "Allow Shaaka to save images to your gallery.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#47ae87"
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d3a023d7-8b01-4084-a888-a0e99844aba9"
      }
    },
    "owner": "segoremys-team"
  }
}
  